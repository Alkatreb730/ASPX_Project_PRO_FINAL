# .env.example
# ضع مفاتيحك هنا (لا تشاركها علناً)

# Data providers
FINNHUB_API_KEY=your_finnhub_key
COINGECKO_API_KEY=your_coingecko_key
TRADINGECONOMICS_KEY=your_tradingeconomics_key
